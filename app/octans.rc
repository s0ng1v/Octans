#include "../include/octans_version.h"

101 ICON "../assets/octans.ico"

1 VERSIONINFO
FILEVERSION OCTANS_VERSION_COMMA
PRODUCTVERSION OCTANS_VERSION_COMMA
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "ProductName", "Octans"
            VALUE "FileDescription", "Octans Wireless Peripheral Battery Monitor"
            VALUE "FileVersion", OCTANS_VERSION_STR
            VALUE "ProductVersion", OCTANS_VERSION_STR
            VALUE "InternalName", "Octans"
            VALUE "OriginalFilename", "Octans.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
